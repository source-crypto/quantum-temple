{
  "name": "AbundanceGoal",
  "type": "object",
  "properties": {
    "goal_name": {
      "type": "string",
      "description": "Name of the abundance goal"
    },
    "description": {
      "type": "string",
      "description": "What this goal aims to manifest"
    },
    "target_transparency": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "description": "Target transparency units (1-12)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active",
      "description": "Goal status"
    },
    "alignment_strategy": {
      "type": "string",
      "description": "How oracles should align toward this goal"
    },
    "target_date": {
      "type": "string",
      "format": "date-time",
      "description": "Desired completion date"
    }
  },
  "required": [
    "goal_name",
    "target_transparency"
  ]
}